# Production only. In dev, Vite proxies /api to http://127.0.0.1:8001 so the
# browser stays on one origin -- which a service worker needs.
VITE_API_URL=

# Production only. The public Blade site, which the logo on the sign-in and
# join pages leads back to. In dev it falls back to http://localhost:8001.
VITE_SITE_URL=
