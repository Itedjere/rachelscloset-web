# Read by `npm run build` (and only by a build). Committed on purpose: neither
# value is a secret -- Vite writes both into the public JavaScript anyway --
# and a build that silently fell back to the dev defaults would ship an app
# talking to localhost.

# Where the API lives. The app calls ${VITE_API_URL}/api/..., so no /api here.
VITE_API_URL=https://rachelscloset.com.ng

# The public site the logo on the sign-in and join pages leads back to.
VITE_SITE_URL=https://rachelscloset.com.ng
